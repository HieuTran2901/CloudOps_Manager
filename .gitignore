# ==============================================================================
# CloudOps Manager — Git Ignore Rules
# ==============================================================================

# --- Secrets, Credentials & Environment Files (CRITICAL) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*credentials*
*.secret
id_rsa
id_ed25519
aws-credentials*
aws-config*
*.session

# --- Operating System & General ---
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*~

# --- IDE & Editors ---
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.project
.classpath
.settings/
bin/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# --- Backend: Java & Maven & Spring Boot ---
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

